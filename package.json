{
  "name": "incident-evidence-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed incident reconstruction from Slack and engineering systems.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:lambda": "node scripts/build-lambda.mjs",
    "build:web": "node scripts/build-review-web.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run build:lambda && npm run build:web && npm run release:manifest && npm run release:verify",
    "db:migrate": "tsx src/infrastructure/postgres/migrate-cli.ts",
    "db:migrate:aws": "tsx src/infrastructure/postgres/migrate-aws-cli.ts",
    "demo:slack": "tsx src/demo/seed-slack-incident-cli.ts",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "eval:live": "tsx src/evaluation/run-evaluation.ts live",
    "eval:offline": "tsx src/evaluation/run-evaluation.ts offline",
    "deployment:check-plan": "tsx src/deployment/check-terraform-plan-cli.ts",
    "deployment:prepare": "tsx src/deployment/prepare-deployment-cli.ts",
    "deployment:smoke": "tsx src/deployment/smoke-deployment-cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "release:manifest": "tsx src/deployment/create-release-manifest-cli.ts",
    "release:verify": "tsx src/deployment/verify-release-cli.ts",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1089.0",
    "@aws-sdk/client-sfn": "^3.1089.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@tanstack/react-query": "^5.101.2",
    "fastify": "^5.0.0",
    "lucide-react": "^1.25.0",
    "pg": "^8.0.0",
    "pino": "^9.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
