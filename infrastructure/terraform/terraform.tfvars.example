aws_region  = "ap-southeast-2"
environment = "development"

# Produce this ZIP from the application build before running terraform plan.
# It must contain both root exports: slack-ingress-main.handler and
# incident-worker-main.handler, plus all production dependencies.
lambda_artifact_path = "../../artifacts/incident-copilot-lambda.zip"

# Only ARNs enter Terraform. Do not put secret values in this file.
slack_signing_secret_arn = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:incident-copilot/dev/slack-AbCdEf"
slack_bot_token_secret_arn = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:incident-copilot/dev/slack-bot-IjKlMn"
database_secret_arn      = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:incident-copilot/dev/database-GhIjKl"

# Lambda is IPv4-only by default, so use Supabase's transaction pooler rather
# than the direct IPv6 database endpoint. Supply only the hostname, never the
# complete connection string. Credentials and the Supabase CA live in the
# database Secrets Manager value described in README.md.
database_host = "aws-0-ap-southeast-2.pooler.supabase.com"
database_port = 6543
database_name = "postgres"

# Leave both empty for Supabase's public TLS endpoint. If a later deployment
# uses PrivateLink or another private endpoint, populate both lists and provide
# the necessary controlled egress; this root does not create a VPC.
worker_subnet_ids         = []
worker_security_group_ids = []

additional_tags = {
  Owner      = "platform-engineering"
  Repository = "slack-rca"
}
