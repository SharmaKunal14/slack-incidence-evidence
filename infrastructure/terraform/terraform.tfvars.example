aws_region  = "ap-southeast-2"
environment = "development"
expected_aws_account_id = "123456789012"

# Produce this ZIP from the application build before running terraform plan.
# It must contain all eight composition roots documented in README.md, plus all
# production dependencies.
lambda_artifact_path = "../../artifacts/incident-copilot-lambda.zip"

# Only ARNs enter Terraform. Do not put secret values in this file.
slack_signing_secret_arn = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:incident-copilot/dev/slack-AbCdEf"
slack_bot_token_secret_arn = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:incident-copilot/dev/slack-bot-IjKlMn"
database_secret_arn      = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:incident-copilot/dev/database-GhIjKl"
# In production this must reference a separate PostgreSQL login with only the
# grants documented in README.md. Development can omit it and reuse the shared
# database secret while bootstrapping.
# review_database_secret_arn = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:incident-copilot/dev/review-database-StUvWx"
openai_api_secret_arn    = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:incident-copilot/dev/openai-MnOpQr"

# Development publishes to Confluence. Only the selected provider's secret is
# readable by the publication Lambda role.
publication_provider      = "CONFLUENCE"
confluence_api_secret_arn = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:incident-copilot/dev/confluence-YzAbCd"
confluence_base_url       = "https://your-site.atlassian.net"
confluence_cloud_id       = "11111111-2222-3333-4444-555555555555"
confluence_space_id       = "123456789"
# confluence_parent_page_id = "987654321"

# In production, use a separate PostgreSQL login with only the publication
# grants. Development can omit this while bootstrapping.
# publication_database_secret_arn = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:incident-copilot/dev/publication-database-EfGhIj"

# To switch back without changing code, set publication_provider = "NOTION"
# and configure the preserved Notion inputs below.
# notion_api_secret_arn      = "arn:aws:secretsmanager:ap-southeast-2:123456789012:secret:incident-copilot/dev/notion-AbCdEf"
# notion_data_source_id      = "0123456789abcdef0123456789abcdef"
# notion_title_property      = "Name"
# notion_incident_id_property = "Incident ID"

# Pin this deliberately in staging/production. A model alias is convenient for
# development but can change behaviour without a source-code deployment.
openai_model = "replace-with-an-approved-model-or-snapshot"

# Lambda is IPv4-only by default, so use Supabase's transaction pooler rather
# than the direct IPv6 database endpoint. Supply only the hostname, never the
# complete connection string. Credentials and the Supabase CA live in the
# database Secrets Manager value described in README.md.
database_host = "aws-0-ap-southeast-2.pooler.supabase.com"
database_port = 6543
database_name = "postgres"

# Raw Slack message snapshots are stamped with this expiry. A separate deletion
# processor is still required to enforce it.
evidence_retention_days = 30

# Each response contains at most 16 message objects: the thread parent plus a
# page of 15 replies. This prevents a bad cursor or an unexpectedly large
# thread from creating an unbounded workflow.
slack_thread_max_pages = 100

# Leave both empty for Supabase's public TLS endpoint. If a later deployment
# uses PrivateLink or another private endpoint, populate both lists and provide
# the necessary controlled egress; this root does not create a VPC.
worker_subnet_ids         = []
worker_security_group_ids = []

additional_tags = {
  Owner      = "platform-engineering"
  Repository = "slack-rca"
}
